# Copy to backend/.env for local work. In production these are set with
# `fly secrets set ...` (backend) and in the Vercel dashboard (frontend).

# ---------------------------------------------------------------- database --
# Supabase -> Project Settings -> Database -> Connection string.
# Use the SESSION POOLER (port 5432) and swap the scheme to postgresql+asyncpg.
#   postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# If you end up on the transaction pooler (6543), also set
# DB_DISABLE_PREPARED_STATEMENTS=true.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rhln
# DB_DISABLE_PREPARED_STATEMENTS=false

# --------------------------------------------------------------- extraction --
# Module A only. Everything else runs without it.
ANTHROPIC_API_KEY=
# EXTRACTION_MODEL=claude-opus-5
# EXTRACTION_CONCURRENCY=4

# ------------------------------------------------------------------ sign-in --
# WorkOS holds every account. The API only ever checks a session token, which
# needs the PUBLIC client id and no secret at all. Leaving it empty leaves the
# API open, which is what the tests and a bare checkout run with; in production
# a missing client id turns everyone away rather than publishing the data.
WORKOS_CLIENT_ID=

# The role-specific dashboards need this set on BOTH sides. Signed in with a
# client id here, the API can say who the caller is; without it every personal
# page reports that the account could not be loaded while the corpus views keep
# working, which looks like a bug and is one setting.

# -------------------------------------------------------------------- misc --
# ENVIRONMENT=development
# LOG_LEVEL=INFO
# DEFAULT_AS_OF=2026-10-01
# GEOCODE_CONCURRENCY=8

# ---------------------------------------------------------------- frontend --
# These belong in frontend/.env.local, not here. See frontend/.env.local.example
# for the WorkOS half - the frontend is the side that holds the API key, because
# signing in happens server-side inside it.
#
# Where the Next.js server proxies /api/* to.
# Local: http://127.0.0.1:8080   Production: https://rhln-api.fly.dev
BACKEND_URL=http://127.0.0.1:8080
