# Copy to frontend/.env.local. In production these are set in the Vercel
# dashboard. Everything here except NEXT_PUBLIC_WORKOS_REDIRECT_URI is a server
# secret and never reaches the browser.

# Where the Next.js server proxies /api/* to.
# Local: http://127.0.0.1:8080   Production: https://rhln-api.fly.dev
BACKEND_URL=http://127.0.0.1:8080

# --------------------------------------------------------------- sign-in ----
# WorkOS dashboard -> pick the environment (staging for local work) -> API Keys.
# The frontend holds the secret because signing in happens server-side in it:
# /auth/sign-in puts email and password to WorkOS and seals the answer into the
# session cookie. The API gets only the client id (see ../.env.example).
#
# Leave these empty and the app runs without accounts: no sign-in card, open
# corpus views, open API. That is a supported mode outside production.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=

# Seals the session cookie. Generate with: openssl rand -base64 32
# At least 32 characters, or AuthKit refuses to start.
WORKOS_COOKIE_PASSWORD=

# The one origin an AuthKit flow may begin and end on. It must match the
# Redirect URI registered in the dashboard exactly - `localhost` and
# `127.0.0.1` are the same machine but not the same origin, and a flow started
# on the wrong one comes back to a callback with no cookie to verify.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback
