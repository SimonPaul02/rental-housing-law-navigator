# Copy to frontend/.env.local. In production these are set in the Vercel
# dashboard. Everything here except NEXT_PUBLIC_WORKOS_REDIRECT_URI is a server
# secret and never reaches the browser.

# Where the Next.js server proxies /api/* to.
# Local: http://127.0.0.1:8080   Production: https://rhln-api.fly.dev
BACKEND_URL=http://127.0.0.1:8080

# --------------------------------------------------------------- sign-in ----
# WorkOS dashboard -> API Keys. One environment serves both local work and the
# deployment: one set of keys, one pool of accounts, so an account made here
# works in production too and there is no second user space to keep straight.
#
# The frontend holds the secret because signing in happens server-side in it:
# /auth/sign-in puts email and password to WorkOS and seals the answer into the
# session cookie. The API gets only the client id (see ../.env.example).
#
# Leave these empty and the app runs without accounts: no sign-in card, open
# corpus views, open API. That is a supported mode outside production.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=

# Seals the session cookie. Generate with: openssl rand -base64 32
# At least 32 characters, or AuthKit refuses to start.
WORKOS_COOKIE_PASSWORD=

# The one origin an AuthKit flow may begin and end on *in this deployment*. It
# must match a Redirect URI registered in the dashboard exactly - `localhost`
# and `127.0.0.1` are the same machine but not the same origin, and a flow
# started on the wrong one comes back to a callback with no cookie to verify.
#
# This is the only WorkOS value that differs between local and production; the
# dashboard holds both URIs and this picks which one is in play.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# ------------------------------------------------------------------- map --
# The basemap behind the pins. Optional: the default is CARTO's Positron,
# which needs no key. Any MapLibre style URL works, and if it will not load
# the pins, filters and popups still do - the map says so rather than
# disappearing.
# NEXT_PUBLIC_MAP_STYLE=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
